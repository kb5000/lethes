# Generate a random secret of at least 16 characters; keep it across restarts.
LETHES_API_KEY=
LETHES_PORT=8000
LETHES_NETWORK=lethes-local
# Intel/AMD CPU. For ARM64 / Apple Silicon use cpu-arm64-1.9 instead.
LETHES_EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
LETHES_EMBEDDING_PORT=8081
